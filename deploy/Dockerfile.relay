# syntax=docker/dockerfile:1

# Go Relay image for the single-origin deployment unit. The binary is static
# (CGO off) and self-contained: SQL migrations are embedded via `go:embed`, so
# no source or migrations directory is needed at runtime.

FROM golang:1.27-alpine AS build
WORKDIR /src
# Cache module downloads separately from the source copy.
COPY services/relay/go.mod services/relay/go.sum ./
RUN go mod download
COPY services/relay/ ./
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/relay .

FROM alpine:3.20
RUN apk add --no-cache ca-certificates tzdata \
    && adduser -D -u 10001 nodus \
    && mkdir -p /var/lib/nodus/buffer \
    && chown -R nodus:nodus /var/lib/nodus
COPY --from=build /out/relay /usr/local/bin/relay
USER nodus
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/relay"]
