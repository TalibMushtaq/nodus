# Reverse proxy for the Nodus server unit.
#
# Production uses three separate origins:
#   WEB_HOST   -> the Next.js app and its same-origin BFF (/api/*)
#   RELAY_HOST -> the Go Relay (WebSocket, auth, pairing, shard buffer)
#   DOCS_HOST  -> the Fumadocs site
#
# The browser talks to RELAY_HOST for /ws (NEXT_PUBLIC_RELAY_URL); mobile and
# Storage Nodes use RELAY_HOST for everything. The web BFF still reaches the
# Relay internally over http://relay:8080.
#
# A localhost single-origin block is kept for `docker compose up` and the e2e
# harness: those flows have no DNS/TLS and expect /health, /api/*, and /ws on
# the same origin.

{$WEB_HOST} {
	encode gzip
	reverse_proxy web:3000
}

{$RELAY_HOST} {
	encode gzip
	reverse_proxy relay:8080
}

{$DOCS_HOST} {
	encode gzip
	reverse_proxy docs:3001
}

http://localhost, http://127.0.0.1 {
	encode gzip

	@relay {
		path /ws /health /rebuild /activities /folder-envelopes \
 /shards/* \
 /files /files/* /folders \
 /tombstones /tombstones/* \
 /envelopes /envelopes/* \
 /account/* \
 /auth/register /auth/login /auth/session /auth/logout \
 /auth/password /auth/logout-all /auth/recovery /auth/recovery/* \
 /devices /devices/* \
 /nodes /nodes/* /node/shards/* \
 /pairing/sessions /pairing/sessions/* \
 /pairing/codes /pairing/codes/* \
 /buffer/upload /buffer/fetch
		# A browser asking for a page keeps the Next.js page of the same name.
		not header Accept *text/html*
	}
	handle @relay {
		reverse_proxy relay:8080
	}

	handle {
		reverse_proxy web:3000
	}
}
