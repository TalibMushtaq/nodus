# Single-origin reverse proxy for the combined Nodus server unit.
#
# SITE_ADDRESS is the one public origin. A bare ":80" serves plain HTTP (local
# runs or an upstream TLS terminator); a domain such as "nodus.example.com"
# makes Caddy provision and renew HTTPS automatically.
#
# Routing: the Relay owns every path a non-browser client answers directly —
# the WebSocket gateway, the shard buffer, auth, devices, nodes, the bootstrap
# pairing endpoints, rebuild, and health. This keeps mobile/CLI clients working
# against the single origin, not just the browser and the Storage Node.
#
# Three Relay paths also exist as Next.js pages: `/devices`, `/files` and
# `/tombstones`. They are disambiguated by content negotiation rather than by
# dropping one client: a browser navigation sends `Accept: text/html` and stays
# with Next, while an API client (mobile, CLI, Storage Node) sends JSON or
# `*/*` and reaches the Relay. Without this, an enumerated list has to pick a
# winner, and whichever it picks the other client breaks — which is how the
# Relay's `/devices` and `/tombstones` came to be unreachable through the proxy.
#
# Everything not matched below (all pages, `/api/*`, static assets) is served
# by Next.js.

{$SITE_ADDRESS} {
	encode gzip

	@relay {
		path /ws /health /rebuild /activities /folder-envelopes \
		 /shards/* \
		 /files /files/* /folders \
		 /tombstones /tombstones/* \
		 /envelopes /envelopes/* \
		 /account/* \
		 /auth/register /auth/login /auth/session /auth/logout \
		 /auth/password /auth/logout-all /auth/recovery /auth/recovery/* \
		 /devices /devices/* \
		 /nodes /nodes/* /node/shards/* \
		 /pairing/sessions /pairing/sessions/* \
		 /pairing/codes /pairing/codes/* \
		 /buffer/upload /buffer/fetch
		# A browser asking for a page keeps the Next.js page of the same name.
		not header Accept *text/html*
	}
	handle @relay {
		reverse_proxy relay:8080
	}

	handle {
		reverse_proxy web:3000
	}
}
