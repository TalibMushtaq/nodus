# syntax=docker/dockerfile:1

# Next.js web image for the single-origin deployment unit. Builds the monorepo
# from the repo root and ships only Next's `standalone` output plus the static
# assets it expects, so the runtime layer has no package manager or sources.

FROM node:24-bookworm-slim AS build
ENV PNPM_HOME=/pnpm \
    PATH=/pnpm:$PATH \
    NEXT_TELEMETRY_DISABLED=1 \
    TURBO_TELEMETRY_DISABLED=1
RUN corepack enable && corepack prepare pnpm@11.23.0 --activate
WORKDIR /repo
# `.dockerignore` keeps node_modules/.next/target out, so this copies the whole
# workspace (all manifests are needed for a frozen-lockfile install).
COPY . .
RUN pnpm install --frozen-lockfile
# Build web plus the workspace packages it imports (turbo `^build`); packages
# like @repo/core ship compiled `dist/`, which a web-only build would miss.
RUN pnpm exec turbo run build --filter=web

FROM node:24-bookworm-slim AS runner
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0
RUN groupadd -g 10001 nodus && useradd -u 10001 -g nodus -m nodus
WORKDIR /app
# With outputFileTracingRoot at the repo root, the standalone bundle mirrors the
# workspace layout (`apps/web/server.js`), and static/public must be placed in
# that same subtree by hand.
COPY --from=build --chown=nodus:nodus /repo/apps/web/.next/standalone ./
COPY --from=build --chown=nodus:nodus /repo/apps/web/.next/static ./apps/web/.next/static
COPY --from=build --chown=nodus:nodus /repo/apps/web/public ./apps/web/public
USER nodus
EXPOSE 3000
CMD ["node", "apps/web/server.js"]
