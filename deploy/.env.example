# Copy to deploy/.env and adjust for the deployment.

# The single public origin.
#   ":80"                    -> plain HTTP (local, or TLS terminated upstream)
#   "nodus.example.com"      -> Caddy provisions HTTPS automatically
SITE_ADDRESS=:80

# Operator-configured public origin shown to users and used by Storage Nodes.
# Must be exactly how the origin is reached (scheme + host + port). For the
# production domain above this is e.g. https://nodus.example.com.
PUBLIC_RELAY_URL=http://localhost

# Browser Origin allowed to open the Relay WebSocket. Must match the public
# origin (scheme + host + port); comma/space separated for multiple.
ALLOWED_ORIGINS=http://localhost

# true when the public origin is HTTPS (production); false only for local HTTP.
SESSION_COOKIE_SECURE=false

# PostgreSQL credentials for the bundled database (change in production).
POSTGRES_USER=nodus
POSTGRES_PASSWORD=nodus_password
POSTGRES_DB=nodus_relay

# How long Relay-buffered shards are retained.
BUFFER_TTL_HOURS=72
