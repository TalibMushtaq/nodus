# Copy to deploy/.env and adjust for the deployment.

# ── Public origins ──────────────────────────────────────────────────────────
# Production uses three hostnames on one VM. Caddy provisions and renews TLS for
# each. The localhost defaults keep `docker compose up` and the e2e harness
# working without DNS (they use the Caddyfile's localhost single-origin block).
WEB_HOST=nodus.localhost
RELAY_HOST=relay.nodus.localhost
DOCS_HOST=doc.nodus.localhost

# Public Relay origin shown to users and used by Storage Nodes/mobile. In the
# split deployment this is the relay subdomain, not the web origin.
PUBLIC_RELAY_URL=http://localhost

# Browser WebSocket target, inlined into the web bundle at build time. Use
# https://relay.<domain> for the split deployment; leave http://localhost for
# the local single-origin smoke test.
NEXT_PUBLIC_RELAY_URL=http://localhost

# Browser Origin allowed to open the Relay WebSocket. Must match the web origin
# (scheme + host + port); comma/space separated for multiple. In production set
# https://<WEB_HOST>.
ALLOWED_ORIGINS=http://localhost,http://127.0.0.1

# true when the public origin is HTTPS (production); false only for local HTTP.
SESSION_COOKIE_SECURE=false

# Split deployments set the parent domain (e.g. ".nodus.talibdar.tech") so the
# session cookie is also sent to the Relay subdomain's WebSocket. Leave empty
# for local/single-origin runs.
SESSION_COOKIE_DOMAIN=

# TRUST_PROXY is not set here on purpose: docker-compose.yml pins it to true
# because Caddy is the Relay's immediate peer in this deployment, and the rate
# limiter may only trust X-Forwarded-For when the proxy is the one setting it.
# Set it to true by hand only if you run the same topology (nothing but your
# reverse proxy can reach the Relay's port), and leave it false if the Relay is
# directly reachable — otherwise anyone can spoof their X-Forwarded-For and walk
# around the per-IP rate limits.

# ── Required credentials ─────────────────────────────────────────────────────
# Compose refuses to start without REDIS_PASSWORD rather than falling back to a
# guessable default. It is interpolated into a connection URL, so it must be
# URL-safe: no "@", ":", "/", "#" or whitespace. Compose does not encode it, and
# a value containing one produces a connection error that looks like a network
# problem rather than a config mistake.
#
# The relay's database is a SQLite file under the relay_data volume
# (/var/lib/nodus/relay.db); there is no database password to configure.

# Redis password. Required because Redis is not a cache here: it holds
# fetch_token:<token>, which is itself the credential for the unauthenticated
# GET /buffer/fetch, plus node and device auth nonces. Every service in the
# compose file shares one network, so an unauthenticated Redis gives those to
# anything that can reach the port.
REDIS_PASSWORD=nodus_redis_password

# How long Relay-buffered shards are retained.
BUFFER_TTL_HOURS=72

# Largest plaintext shard the Relay will buffer. Must be >= the largest shard
# size a client can select (Settings offers up to 32 MB); a smaller value makes
# Path C reject those shards, which then fall back to the device-local queue.
MAX_SHARD_BYTES_MB=32

# ── Push notifications (optional) ───────────────────────────────────────────
# Mobile (Expo). Access token from expo.dev > Account settings > Access tokens;
# optional for low volume but required in production. Real delivery also needs
# EAS/APNs/FCM credentials configured on the Expo project.
EXPO_PUSH_ACCESS_TOKEN=

# Web Push (VAPID). Generate a pair with `npx web-push generate-vapid-keys`.
# Browser push is disabled unless both keys are set. The public key must also be
# set as NEXT_PUBLIC_VAPID_PUBLIC_KEY on the web app.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
