# Copy to .env for local development (the .env file itself is git-ignored).

# Relay origin the app talks to. A non-local origin MUST be https:// (or
# wss://): the app refuses to send the bearer session over cleartext. Cleartext
# http(s) is accepted only for loopback and the Android emulator alias
# (localhost, 127.0.0.1, ::1, 10.0.2.2).
EXPO_PUBLIC_RELAY_URL=http://10.0.2.2:8080

# Production example:
# EXPO_PUBLIC_RELAY_URL=https://relay.example.com

# EAS project id used to mint an Expo push token (expo.dev -> Project -> Project
# ID). Unset disables push registration on the client; the app still works.
EXPO_PUBLIC_EAS_PROJECT_ID=
