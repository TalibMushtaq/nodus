{
  "expo": {
    "name": "Nodus",
    "slug": "nodus",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "nodus",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.talibmushtaq.nodus",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Nodus discovers and pairs with storage nodes on your local network.",
        "NSBonjourServices": [
          "_nodus._tcp"
        ],
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "usesCleartextTraffic": true,
      "permissions": [
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.CHANGE_WIFI_MULTICAST_STATE",
        "android.permission.NEARBY_WIFI_DEVICES",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.talibmushtaq.nodus"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-background-task",
      "./plugins/with-rnscreens-fragment-factory",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24
          }
        }
      ],
      "expo-font",
      "expo-notifications"
    ],
    "extra": {
      "eas": {
        "projectId": "e2e3757d-4efd-4ee0-94c4-ebf0d62bfb53"
      }
    },
    "owner": "talibmushtaq"
  }
}
