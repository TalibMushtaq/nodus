# Web app environment (server + browser). Copy to .env.local for local dev.

# Internal Relay base used by Next route handlers/lib/relay.ts. Server-only —
# never exposed to the browser. Dev default: http://localhost:8080.
RELAY_URL=http://localhost:8080

# Operator-configured public origin shown to users for `nodus node pair`
# (e.g. https://nodus.example.com). Required to display the relay URL and CLI
# command in the "+ Add Storage Node" dialog. Never inferred from Host headers.
PUBLIC_RELAY_URL=

# Browser WebSocket origin for the Relay. Optional in a single-origin deploy:
# when unset the browser uses this page's own origin for /ws, which is the
# production default. Only set it for a split dev setup where the web app
# (:3000) and Relay (:8080) run on separate ports — because anything prefixed
# NEXT_PUBLIC_ is inlined into the client bundle, do NOT set this in production.
# NEXT_PUBLIC_RELAY_URL=http://localhost:8080
