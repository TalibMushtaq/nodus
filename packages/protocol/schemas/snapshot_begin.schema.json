{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "snapshot_id": {
      "type": "string"
    },
    "node_id": {
      "type": "string"
    },
    "snapshot_sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "total_chunks": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "content_hash": {
      "type": "string"
    },
    "signature": {
      "type": "string"
    },
    "data_schema_version": {
      "type": "string"
    },
    "cursors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "origin_id": {
            "type": "string"
          },
          "sequence": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "origin_id",
          "sequence"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "snapshot_id",
    "node_id",
    "snapshot_sequence",
    "total_chunks",
    "content_hash",
    "signature",
    "data_schema_version",
    "cursors"
  ],
  "additionalProperties": false
}
