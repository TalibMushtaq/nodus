{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "snapshot_id": {
      "type": "string"
    },
    "chunk_index": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "record_type": {
      "type": "string",
      "enum": [
        "file_version",
        "tombstone"
      ]
    },
    "records": {
      "maxItems": 1000,
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "file_id": {
                "type": "string"
              },
              "version_number": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "parent_version_id": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "conflict_status": {
                "type": "string",
                "enum": [
                  "none",
                  "flagged",
                  "resolved"
                ]
              },
              "version_hash": {
                "type": "string"
              },
              "shard_count": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "encrypted_name": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "parent_folder_id": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "file_id",
              "version_number",
              "version_hash",
              "shard_count"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "entity_type": {
                "type": "string",
                "enum": [
                  "file",
                  "folder"
                ]
              },
              "entity_id": {
                "type": "string"
              },
              "deleted_at": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
              }
            },
            "required": [
              "entity_type",
              "entity_id",
              "deleted_at"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": [
    "snapshot_id",
    "chunk_index",
    "record_type",
    "records"
  ],
  "additionalProperties": false
}
