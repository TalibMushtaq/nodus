{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "node_id": {
      "type": "string"
    },
    "cursors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "origin_id": {
            "type": "string"
          },
          "sequence": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "known_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "origin_id",
          "sequence",
          "known_count"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "node_id",
    "cursors"
  ],
  "additionalProperties": false
}
