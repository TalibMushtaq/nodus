{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "file_id": {
      "type": "string"
    },
    "version_number": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "shard_index": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "hash": {
      "type": "string"
    },
    "size": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "transfer_id": {
      "type": "string"
    },
    "target_node": {
      "type": "string"
    },
    "source_device": {
      "type": "string"
    }
  },
  "required": [
    "file_id",
    "version_number",
    "shard_index",
    "hash",
    "size",
    "transfer_id"
  ],
  "additionalProperties": false
}
