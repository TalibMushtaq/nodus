{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "shard_data": {
      "type": "boolean",
      "const": true
    },
    "hash": {
      "type": "string"
    },
    "size": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "transfer_id": {
      "type": "string"
    }
  },
  "required": [
    "shard_data",
    "hash",
    "size",
    "transfer_id"
  ],
  "additionalProperties": false
}
