{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "account_id": {
      "type": "string"
    },
    "device_id": {
      "type": "string"
    },
    "node_id": {
      "type": "string"
    },
    "public_key": {
      "type": "string"
    },
    "capabilities": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "storage",
          "signaling",
          "sync"
        ]
      }
    }
  },
  "required": [
    "account_id",
    "public_key",
    "capabilities"
  ],
  "additionalProperties": false
}
