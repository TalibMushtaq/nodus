{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "node_id": {
      "type": "string"
    },
    "reason": {
      "type": "string",
      "enum": [
        "token_expired",
        "token_consumed",
        "token_unknown",
        "device_mismatch",
        "node_offline"
      ]
    },
    "message": {
      "type": "string"
    }
  },
  "required": [
    "reason"
  ],
  "additionalProperties": false
}
