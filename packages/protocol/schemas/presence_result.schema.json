{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "request_id": {
      "type": "string"
    },
    "peer_id": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "node",
        "device"
      ]
    },
    "online": {
      "type": "boolean"
    },
    "rtt_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "reason": {
      "type": "string"
    }
  },
  "required": [
    "request_id",
    "peer_id",
    "kind",
    "online"
  ],
  "additionalProperties": false
}
