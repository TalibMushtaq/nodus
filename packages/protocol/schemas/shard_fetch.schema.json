{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "file_id": {
      "type": "string"
    },
    "shard_index": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "transfer_id": {
      "type": "string"
    },
    "source": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "string",
          "const": "relay_buffer"
        }
      ]
    }
  },
  "required": [
    "file_id",
    "shard_index",
    "transfer_id",
    "source"
  ],
  "additionalProperties": false
}
