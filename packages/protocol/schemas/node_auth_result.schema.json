{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "ok",
        "fail"
      ]
    },
    "message": {
      "type": "string"
    },
    "reason": {
      "type": "string",
      "enum": [
        "node_not_found",
        "node_inactive"
      ]
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "node_id": {
            "type": "string"
          },
          "public_key": {
            "type": "string"
          }
        },
        "required": [
          "node_id",
          "public_key"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "status"
  ],
  "additionalProperties": false
}
